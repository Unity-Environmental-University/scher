{
  "name": "scher",
  "version": "0.3.0",
  "description": "A metaphysics-native reactive component library — Stories that are event horizons.",
  "type": "module",
  "license": "MIT",
  "repository": "github:Unity-Environmental-University/scher",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./society": {
      "types": "./dist/society.d.ts",
      "default": "./dist/society.js"
    },
    "./stories": {
      "types": "./dist/stories.d.ts",
      "default": "./dist/stories.js"
    },
    "./cell": {
      "types": "./dist/cell.d.ts",
      "default": "./dist/cell.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    },
    "./frames": {
      "types": "./dist/frames.d.ts",
      "default": "./dist/frames.js"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "default": "./dist/projection.js"
    },
    "./fisheye": {
      "types": "./dist/fisheye.d.ts",
      "default": "./dist/fisheye.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run check && npm run test && npm run build"
  },
  "devDependencies": {
    "fast-check": "^4.8.0",
    "jsdom": "^29.1.1",
    "typescript": "5.7.2",
    "vitest": "^4.1.9"
  }
}
